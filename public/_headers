/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: document-domain=(), geolocation=(), camera=(), microphone=()
  X-XSS-Protection: 1; mode=block

# Hashed Vite assets — cache forever (filenames contain content hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Booklets catalog — short cache with background revalidation
/booklets-catalog.json
  Cache-Control: public, max-age=300, stale-while-revalidate=600
  Access-Control-Allow-Origin: *

# Favicons and static images — cache 1 year
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable

# HTML entry — always revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

# Web manifest
/site.webmanifest
  Cache-Control: public, max-age=86400
